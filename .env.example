# MySQL（docker-compose 與 ETL 會讀取）
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=youbike_db
MYSQL_USER=youbike
MYSQL_PASSWORD=your_app_password_here

# Airflow（可選，預設 admin / admin）
# 正式部署不要使用預設帳密。
# AIRFLOW_USER=admin
# AIRFLOW_PASSWORD=admin
# AIRFLOW_WEBSERVER_SECRET_KEY=your_random_secret_key

# FastAPI（可選）
# API_DEMO_MODE=false
# API_LOG_LEVEL=INFO

# Dashboard（可選）
# DASHBOARD_DEMO_MODE=false
# API_BASE_URL=http://api:8000

# ETL validation（可選）
# ETL_VALIDATION_MODE=strict

# 可選：若 ETL 在容器外執行，可設定 DB 連線（本機用 127.0.0.1）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=youbike
# DB_PASSWORD=your_app_password_here
# DB_NAME=youbike_db

# GCP Secret Manager（未設定 DB_PASSWORD 時會使用）
# GCP_PROJECT_ID=youbike-airflow-server
# GCP_SECRET_ID=mysql_password

# API 連線（ETL 抓 YouBike 開放資料用）
# API_TIMEOUT=30
# API_RETRIES=3
# API_RETRY_BACKOFF=2.0

# dbt dependency install（可選；dbt-mysql 目前以 Python 3.11 驗證）
# DBT_PYTHON=python3.11
